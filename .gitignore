# Ignore everything by default.
*

# Never commit installed JavaScript dependencies.
**/node_modules/

# Keep the repository definition itself.
!.gitignore

# Keep project documentation.
!docs/
!docs/**

# Keep editor agent definitions shared by the team.
!.github/
!.github/agents/
!.github/agents/**

# Keep tests (screenshots are local output).
!tests/
!tests/**
tests/ui/shots/

# Keep all plugins.
!plugins/
!plugins/**

# Keep only the selected themes.
!themes/
themes/*
!themes/hello-elementor/
!themes/hello-elementor/**
!themes/hello-elementor-child/
!themes/hello-elementor-child/**

# Keep installed dependencies out even inside allowed themes/plugins.
**/node_modules/
**/node_modules/**

# Never commit logs (they may contain personal data).
**/amnesty-debug.log
**/*.log

# Local OS/editor junk.
**/.DS_Store
**/Thumbs.db
